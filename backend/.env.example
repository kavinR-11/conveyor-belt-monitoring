# =============================================================================
# Conveyor Belt Monitoring — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials.
# =============================================================================

# ── Twilio SMS Credentials ──
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# ── Alert Phone Numbers (comma-separated, E.164 format) ──
# Admin receives all alerts (WARNING + CRITICAL + EMERGENCY)
ALERT_ADMIN_PHONES=+917305198655

# Maintenance crew receives CRITICAL + EMERGENCY only
ALERT_MAINTENANCE_PHONES=+917305198655

# ── MQTT Broker ──
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=conveyor/cv-iron-01

# ── Backend ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
